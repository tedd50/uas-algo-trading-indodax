# Salin ke .env (lokal) atau isi di Vercel > Project > Settings > Environment Variables.
# JANGAN commit .env. Semua nilai di bawah sengaja kosong.

# Secret untuk melindungi /api/tick, /api/admin, /api/health (min. 16 karakter acak).
# Vercel Cron otomatis mengirim "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Upstash Redis (Vercel Marketplace mengisi otomatis salah satu pasangan ini)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Namespace kunci storage (ganti untuk uji coba agar log forward test bersih)
KEY_PREFIX=uas

# Kill switch darurat lewat env (butuh redeploy); cara utama: POST /api/admin?action=kill_on
KILL_SWITCH=0
